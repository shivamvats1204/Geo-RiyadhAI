# Copy to .env. Never commit real values.
GEOACQUIRER_CACHE=./cache
# GEOACQUIRER_OVERTURE_RELEASE=2026-09-23.1

# Optional LLM compiler (any OpenAI-compatible endpoint, hosted or local)
# GEOACQUIRER_LLM_URL=http://localhost:11434/v1
# GEOACQUIRER_LLM_MODEL=
# GEOACQUIRER_LLM_KEY=

# Proprietary adapters are OFF unless BOTH the enable flag and a recorded authorization reference are set.
# GEOACQUIRER_ENABLE_SUHAIL=1
# GEOACQUIRER_SUHAIL_AUTHORIZATION_REF=<contract / permission id>
# GEOACQUIRER_ENABLE_URBI=1
# GEOACQUIRER_URBI_AUTHORIZATION_REF=<contract / permission id>
# GEOACQUIRER_URBI_API_KEY=<your own key; do NOT reuse the key from the old notebook>

# Copy this file to .env (same folder) and fill in ONE of the two options. Restart the server afterwards.
# Real environment variables override this file. Never commit .env.

# --- Option A: Anthropic ---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# RIYADHAI_LLM_MODEL=claude-sonnet-5-5

# --- Option B: any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LM Studio, a proxy) ---
# RIYADHAI_LLM_URL=http://localhost:11434/v1
# RIYADHAI_LLM_MODEL=your-model-name
# RIYADHAI_LLM_KEY=

# Optional: where the prepared city data lives (default: ~/riyadh_city_store)
# RIYADHAI_CITYSTORE=
